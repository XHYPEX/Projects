    C -->|TIDAK| D["Siap diambil"]:::ok
  end
  subgraph T2["2 · Cek pembayaran"]
    direction LR
    P{"Sisa tagihan?"}:::cek
    P -->|"0 (LUNAS)"| P0["Lanjut serah terima"]:::ok
