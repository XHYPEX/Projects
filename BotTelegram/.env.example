# --- Akun Telegram pribadi (userbot), daftar di https://my.telegram.org/apps ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Bot tujuan (dibuat via @BotFather), yang akan post ke channel/grup member kamu ---
# Bot yang sama dipakai buat post ke SEMUA channel tujuan di routes.json.
# Pastikan bot ini jadi admin di tiap channel tujuan yang kamu pakai.
TARGET_BOT_TOKEN=

# Pasangan grup/channel SUMBER -> TUJUAN (sampai 5 pasangan) diatur di routes.json,
# bukan di sini. Copy routes.json.example jadi routes.json, atau atur lewat config_app.py.

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Panjang minimum karakter pesan sumber sebelum diproses (filter noise singkat, mis. "ok", "siap").
# Set 0 kalau mau semua pesan diteruskan tanpa filter panjang.
MIN_MESSAGE_LENGTH=15

# Log ditulis ke stdout (kebaca lewat `journalctl -u bottelegram`) sekaligus ke file
# di bawah ini, yang di-rotate otomatis. Default maks 5MB x 6 file = ~30MB.
LOG_PATH=logs/bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Diagnostik: set 1 buat nge-log SEMUA pesan masuk dari chat mana pun (bukan cuma yang
# ada di routes.json), lengkap sama chat_id-nya -- buat nyari tau kenapa suatu channel
# gak keteruskan. Ikut nge-log DM pribadi juga, jadi matiin lagi kalau udah selesai debug.
DEBUG_LOG_ALL_CHATS=

# Opsional: chat pribadi buat nerima alert kalau bot crash/disconnect (mis. DM ke bot tujuan kamu sendiri).
# Kosongkan kalau belum mau pakai alerting.
ALERT_CHAT_ID=

# --- Login config_app.py (Web UI) -- WAJIB diisi kalau config_app.py mau dijalankan ---
# App ini nolak start kalau salah satu dari 3 ini kosong. Kalau di-expose ke internet
# (bukan cuma diakses lewat SSH tunnel), pilih username/password yang kuat.
CONFIG_APP_USERNAME=
CONFIG_APP_PASSWORD=
# Generate sekali lalu jangan diubah-ubah (ganti = semua orang yang lagi login ke-logout):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CONFIG_APP_SECRET_KEY=
