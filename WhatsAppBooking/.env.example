# meta = Cloud API langsung, kirimdev = lewat Kirimdev (coexistence dengan WhatsApp Business app)
WHATSAPP_PROVIDER=meta

# Kirimdev (kalau WHATSAPP_PROVIDER=kirimdev)
# KIRIM_API_KEY=
# KIRIM_PHONE_ID=
# KIRIM_WEBHOOK_SECRET=   # diisi otomatis oleh register_kirimdev_webhook.py

# WhatsApp Cloud API (kalau WHATSAPP_PROVIDER=meta)
WA_ACCESS_TOKEN=EAAG...            # pakai System User token (permanen), bukan temporary token 24 jam
WA_PHONE_NUMBER_ID=123456789012345
WA_VERIFY_TOKEN=isi-string-acak-bebas
WA_APP_SECRET=abcdef0123456789
# WA_GRAPH_VERSION=v23.0

# Onboarding /onboard (opsional, buat coexistence dengan WhatsApp Business app)
# META_APP_ID=1630785405248872
# FB_LOGIN_CONFIG_ID=
# ONBOARD_KEY=isi-string-acak-panjang

# Google Calendar
GOOGLE_CREDENTIALS_FILE=credentials/service-account.json
GOOGLE_CALENDAR_ID=kamu@gmail.com

# Aturan booking
TIMEZONE=Asia/Jakarta
DEFAULT_DURATION_MINUTES=60
BUSINESS_HOUR_START=09:00
BUSINESS_HOUR_END=17:00
# STATE_DB_PATH=data/state.db
