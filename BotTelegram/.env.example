# --- Akun Telegram pribadi (userbot), daftar di https://my.telegram.org/apps ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Bot tujuan (dibuat via @BotFather), yang akan post ke channel/grup member kamu ---
# Bot yang sama dipakai buat post ke SEMUA channel tujuan di routes.json.
# Pastikan bot ini jadi admin di tiap channel tujuan yang kamu pakai.
TARGET_BOT_TOKEN=

# Pasangan grup/channel SUMBER -> TUJUAN (sampai 5 pasangan) diatur di routes.json,
# bukan di sini. Copy routes.json.example jadi routes.json, atau atur lewat config_app.py.

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Panjang minimum karakter pesan sumber sebelum diproses (filter noise singkat, mis. "ok", "siap")
MIN_MESSAGE_LENGTH=15

# Opsional: chat pribadi buat nerima alert kalau bot crash/disconnect (mis. DM ke bot tujuan kamu sendiri).
# Kosongkan kalau belum mau pakai alerting.
ALERT_CHAT_ID=
