# --- Akun Telegram pribadi (userbot), daftar di https://my.telegram.org/apps ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Grup/channel SUMBER sinyal. Bisa username (contoh: @grupsinyal) atau ID numerik (-100xxxxxxxxxx)
SOURCE_CHAT=

# --- Bot tujuan (dibuat via @BotFather), yang akan post ke channel/grup member kamu ---
TARGET_BOT_TOKEN=
# Channel/grup TUJUAN tempat member kamu baca sinyal. Bot di atas harus jadi admin di sini.
TARGET_CHAT=

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Panjang minimum karakter pesan sumber sebelum diproses (filter noise singkat, mis. "ok", "siap")
MIN_MESSAGE_LENGTH=15
