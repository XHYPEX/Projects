# Secrets & credentials
.env
*.pem
*.key
secrets.json

# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc

# Build output
dist/
build/
*.o
*.exe

# OS noise
.DS_Store
Thumbs.db

# Local application data -- never commit a live database. The app reads DB_PATH
# (backend/database.py) so each install keeps its own copy outside the repo;
# committing one would overwrite a user's real sales/inventory on every update.
*.db
*.db-journal

# Logs & temp files
CLAUDE.md
*.csv
*.log
*.tmp
.cache/