%% Gambar: 10
%% Judul: Pembayaran DP Sales Order
%% Modul: Sales Order — Pembayaran
%% Tujuan: Mencatat uang muka customer satu kali saja dan membawanya ke invoice kasir sebagai pembayaran sebelumnya.
%% Dimulai dari: Customer membayar DP saat membuat SO atau sesudahnya.
%% Proses Utama: Input nominal & metode → validasi → catat → (SO terbit) pindahkan ke invoice → sisa tagihan dihitung di invoice.
%% Hasil: Contoh: SO Rp3.000.000, DP Rp1.000.000 → invoice mencatat Dibayar Rp1.000.000, Sisa Rp2.000.000, status Sebagian.
%% Warning: Nominal DP yang baru diketik / transfer yang belum masuk bukan uang masuk. DP tidak boleh tercatat dua kali sebagai uang masuk (di SO dan di invoice). DP melebihi total SO ditolak. Transfer wajib nama pengirim dan rekening tujuan.
%% Modul Terkait: Sales Order, Cashier/Invoice, Riwayat Invoice, Dashboard (penjualan bulan ini dihitung dari pembayaran).
%% Catatan Programmer: SO draft → preorder_payments. SO terbit → _po_move_payments_to_invoice menulis receipt_payments (tanggal & metode asli) + preorder_payment_allocations sekali saja. Pembayaran berikutnya lewat POST /preorders/{id}/payments langsung ke invoice. Header Idempotency-Key mencegah simpan ganda.
%% Status Implementasi: Sudah ada: DP awal, pindah otomatis ke invoice tanpa dobel, pembayaran lanjutan masuk invoice, metode tunai/transfer/QRIS/debit. K-03 SUDAH: SO hanya bisa terbit bila DP tercatat ≥ 30% total, tanpa pengecualian (dicek saat terbit saja; perubahan SO sesudah terbit tidak dicek ulang). BELUM: status pembayaran PENDING — saat ini setiap pembayaran yang disimpan langsung dihitung uang masuk, tanpa konfirmasi dana diterima (K-18).
flowchart TB
  subgraph T1["1 · Input DP"]
    direction LR
    A(["Customer membayar DP"]):::aksi --> B[/"Nominal + metode:<br/>tunai / transfer / QRIS / debit"/]:::aksi --> C{"Nominal > 0 dan<br/>≤ sisa tagihan SO?"}:::cek
    C -->|TIDAK| E1["Ditolak: nominal tidak valid<br/>atau melebihi tagihan"]:::err
    C -->|YA| D{"Transfer?"}:::cek
    D -->|YA| D2{"Pengirim & rekening<br/>tujuan diisi?"}:::cek
    D2 -->|TIDAK| E2["Ditolak: lengkapi data transfer"]:::err
    D2 -->|YA| OK["Valid"]:::ok
    D -->|TIDAK| OK
    OK --> CF{"Dana benar diterima?<br/>(transfer sudah masuk rekening)"}:::cek
    CF -->|"Belum"| PD["Target: PENDING — bukan uang masuk,<br/>tidak mengaktifkan booking (K-18)"]:::off
    CF -->|"Ya"| OK2["Pembayaran SAH"]:::ok
  end
  subgraph T2["2 · Dicatat di mana?"]
    direction LR
    S{"Status SO?"}:::cek
    S -->|Draft| P1[("Pembayaran SO<br/>'DP awal'")]:::data --> P2["Menunggu SO diterbitkan"]:::tunggu
    S -->|Terbit| P3[("Pembayaran invoice<br/>(nota kasir SO)")]:::data
    P2 -->|"SO diterbitkan"| MV["Pindahkan DP ke invoice SATU KALI<br/>tanggal & metode asli dipertahankan"]:::so --> P3
    DBL{"Simpan ditekan dua kali?"}:::cek
    DBL -->|YA| IG["Kunci idempoten:<br/>permintaan kedua tidak mencatat lagi"]:::ok
  end
  subgraph T3["3 · Efek"]
    direction LR
    R1["Invoice: Dibayar += DP<br/>Sisa = Total − Dibayar"]:::ok --> R2{"Sisa?"}:::cek
    R2 -->|"= Total"| B0["BELUM BAYAR"]:::err
    R2 -->|"Lebih dari 0"| B1["SEBAGIAN"]:::tunggu
    R2 -->|"0"| B2["LUNAS<br/>(pengerjaan TIDAK ikut berubah)"]:::ok
    G{"Mau menerbitkan SO:<br/>DP ≥ 30% total?"}:::cek
    G -->|YA| G1["SO terbit: invoice, cadangan stok,<br/>Draft PO kekurangan"]:::ok
    G -->|TIDAK| G2["Ditolak: tetap Draft<br/>(draft boleh tanpa DP)"]:::err
  end
  T1 --> T2 --> T3
